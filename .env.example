# Telegram
TELEGRAM_TOKEN=your_token_here


# Logger
APP_ENV=production
LOG_LEVEL=info

LOG_ENABLED=true
LOG_DIR=data/logs
LOG_MAX_SIZE_MB=10
LOG_MAX_FILES=7
LOG_MAX_AGE_DAYS=30
LOG_COMPRESS=true


# Database
SNAPSHOT_DB_PATH=data/snapshot.db
STORAGE_DB_PATH=data/storage.db


# Через сколько часов без обновления snapshot.db считается устаревшим.
# Бот не падает, а пишет Warn в лог при старте.
# 0 — отключить проверку (если выгрузка из 1С идёт реже, чем раз в трое суток).
SNAPSHOT_MAX_AGE_HOURS=72


# Files
UPLOADS_DIR=data/uploads
MAX_FILE_SIZE_MB=20
ALLOWED_FILE_EXTS=pdf,doc,docx,xls,xlsx,zip,rar,7z
MAX_SUBMISSIONS_PER_THEME=3


# Прокси для работы, когда Telegram недоступен напрямую.
# Пусто — работаем напрямую, напр, если на машине поднят системный VPN
#
# Tor Browser: socks5://127.0.0.1:9150
PROXY_URL=